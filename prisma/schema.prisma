// The shape of our database.
//
// Prisma reads this file and creates matching tables. To apply changes, run:
//   npx prisma migrate dev --name describe_your_change
//
// The first four tables (User, Account, Session, VerificationToken) are the
// standard set that Auth.js requires to run sign-in. Their field names look odd
// in places (refresh_token, session_state) because Auth.js expects exactly
// those names. Do not rename them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- accounts

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]
  consent  Consent?

  // One resume per account for now. Because userId below is @unique, this is a
  // one-to-one relation, which is why it is "resume" and not "resumes".
  resume Resume?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ------------------------------------------------------- ours starts here

// What a student agreed to, and when.
model Consent {
  id     String @id @default(cuid())
  userId String @unique

  acceptedTerms    Boolean @default(false)
  resumePermission Boolean @default(false)
  emailPermission  Boolean @default(false)

  agreedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A student's resume.
//
// We keep BOTH the text and the original file. The text is what the AI reads.
// The file is kept so the student can download their own resume again, and so a
// later stage can attach it to an application email — the extracted words alone
// cannot be sent to an employer.
//
// This is personal data at rest: a resume carries a name, a phone number and a
// work history. It is only stored because the student ticked the permission box
// on the consent screen. Deleting it must stay possible.
model Resume {
  id     String @id @default(cuid())
  userId String @unique

  fileName  String
  fileType  String // "pdf" or "docx"
  sizeBytes Int
  text      String // the extracted words — this is what we analyse

  // The uploaded file itself.
  //
  // Both of these are optional because a resume uploaded in the brief window
  // before we started keeping files has no bytes stored. fileStored is what the
  // pages check, so they never promise a download that cannot happen.
  fileData   Bytes?
  fileStored Boolean @default(false)

  uploadedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses Analysis[]
}

// The feedback produced from a resume.
//
// SQLite cannot store a list inside a column, so the three list-shaped fields
// are stored as JSON text and unpacked in the app. lib/ai.js writes them and
// the results page reads them.
model Analysis {
  id       String @id @default(cuid())
  resumeId String

  summary       String // a few sentences of overall feedback
  strengths     String // JSON array of strings
  improvements  String // JSON array of strings
  bestFitFields String // JSON array of strings

  model     String // which model produced this, for your own records
  createdAt DateTime @default(now())

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
}
