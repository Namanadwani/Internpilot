# InternPilot environment variables
#
# This file is a TEMPLATE and is safe to commit — it lists variable NAMES only,
# never real values.
#
# To use it: copy this file to `.env.local` and fill in real values there.
# `.env.local` is listed in .gitignore, so your real keys stay on your machine.
#
# Setting up on another computer? Copy this file to `.env.local` and fill in
# every value again — the Google values come from your Google Cloud project,
# and the auth secret is generated fresh with:
#   openssl rand -base64 32
# (or run `npx auth secret`, which writes it into the file for you)

# --- Google sign-in ----------------------------------------------------
# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# of type "Web application".
# The authorised redirect URI must be exactly:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# A long random string that keeps sign-in sessions secure. Generate your own —
# never reuse someone else's and never commit the real one.
AUTH_SECRET=

# --- Database ----------------------------------------------------------
# This one lives in `.env`, NOT `.env.local`, because the Prisma command-line
# tool only reads `.env`. It is not a secret. The path is relative to the
# prisma folder, so this creates prisma/dev.db.
DATABASE_URL="file:./dev.db"

# --- Resume feedback (Stage 4) -----------------------------------------
# From https://console.anthropic.com → API Keys. It starts with "sk-ant-".
# Billing must be set up on that account, or every request is refused.
# This one lives in `.env.local` (the app reads it) — never in code, never in git.
ANTHROPIC_API_KEY=

# Optional. Which model writes the resume feedback. Leave it out to use the
# default in lib/ai.js. Change it only if your account cannot reach the default.
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Not planned: sending email as the student from their Gmail. Google treats
# that as a "restricted scope" and requires app verification plus a paid
# third-party security assessment before the public can use it. InternPilot
# drafts the email and hands it to the student to send instead.
