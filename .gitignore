# Dependencies (installed by `npm install`, never committed)
/node_modules

# Next.js build output
/.next/
/out/
/build

# Local database files — these hold real student data and must never be
# committed. The migrations folder (prisma/migrations) IS committed, because
# that is the recipe for rebuilding the tables anywhere.
/prisma/*.db
/prisma/*.db-journal

# Prisma generated client
/lib/generated/

# Environment files — THIS IS THE IMPORTANT ONE.
# Anything starting with .env is ignored, so real API keys can never be
# committed by accident. .env.example is exempted below because it holds
# placeholder names only, never real values.
.env*
!.env.example

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# macOS
.DS_Store

# Vercel
.vercel
